{
  "name": "incompact3d-plunging-criterion",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "ubuntu",
  "runArgs": [
    "--privileged"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "fortran-lang.linter-gfortran"
      ]
    }
  },
  "postCreateCommand": "gfortran --version && mpif90 --version"
}
